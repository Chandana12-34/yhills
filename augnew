# ============================================================
# CALL LLM
# ============================================================

def call_llm(
    system_prompt,
    user_prompt
):

    headers = {
        "Content-Type": "application/json",
        "Authorization": f"Bearer {API_KEY}"
    }

    payload = {

        "model": MODEL_NAME,

        "temperature": 0,

        "messages": [

            {
                "role": "system",
                "content": system_prompt
            },

            {
                "role": "user",
                "content": user_prompt
            }
        ]
    }

    response = requests.post(
        API_URL,
        headers=headers,
        json=payload,
        timeout=REQUEST_TIMEOUT
    )

    response.raise_for_status()

    response_json = response.json()

    try:

        content = (
            response_json
            ["choices"][0]
            ["message"]
            ["content"]
        )

    except Exception:

        raise ValueError(
            "Unexpected LLM response:\n"
            + json.dumps(
                response_json,
                indent=2
            )
        )

    return content


