# ============================================================
# EXCEL FORMATTING
# ============================================================

def format_excel(
    df,
    output_file,
    sheet_name
):

    with pd.ExcelWriter(
        output_file,
        engine="xlsxwriter"
    ) as writer:

        df.to_excel(
            writer,
            sheet_name=sheet_name,
            index=False
        )

        workbook = writer.book

        worksheet = writer.sheets[
            sheet_name
        ]

        # ----------------------------------------------------
        # HEADER
        # ----------------------------------------------------

        header_format = workbook.add_format({

            "bold": True,

            "bg_color": "#CFE2F3",

            "border": 1,

            "text_wrap": True,

            "valign": "top"
        })

        # ----------------------------------------------------
        # CELL
        # ----------------------------------------------------

        cell_format = workbook.add_format({

            "text_wrap": True,

            "valign": "top",

            "border": 1
        })

        # ----------------------------------------------------
        # HEADERS
        # ----------------------------------------------------

        for col_num, column in enumerate(
            df.columns
        ):

            worksheet.write(
                0,
                col_num,
                column,
                header_format
            )

        # ----------------------------------------------------
        # CELLS
        # ----------------------------------------------------

        for row_num in range(
            1,
            len(df) + 1
        ):

            for col_num in range(
                len(df.columns)
            ):

                value = df.iloc[
                    row_num - 1,
                    col_num
                ]

                worksheet.write(
                    row_num,
                    col_num,
                    value,
                    cell_format
                )

        # ----------------------------------------------------
        # COLUMN WIDTHS
        # ----------------------------------------------------

        widths = {

            "A:A": 20,

            "B:B": 50,

            "C:C": 35,

            "D:D": 60,

            "E:E": 40,

            "F:F": 60
        }

        for column_range, width in widths.items():

            worksheet.set_column(
                column_range,
                width,
                cell_format
            )

        # Freeze header
        worksheet.freeze_panes(
            1,
            0
        )

        # Filter
        worksheet.autofilter(
            0,
            0,
            len(df),
            len(df.columns) - 1
        )


