def derive_sub_category(row):
    existing = str(row.get("Sub Category", "")).strip()
    description = str(row.get("Description", "")).lower()
    comments = str(row.get("Comments", "")).lower()

    text = f"{description} {comments}"

    # Keep a meaningful existing sub-category
    if existing and existing.lower() not in {"nan", "none", "other"}:
        return existing

    if any(x in text for x in [
        "slowness",
        "slow performance",
        "performance issue",
        "performance problem"
    ]):
        return "Performance and Slowness"

    if "kyc" in text or "escalation form" in text:
        return "KYC and Escalation Form"

    if "crds" in text:
        return "Up & Downstream with CRDS"

    if any(x in text for x in [
        "workflow exception",
        "workflow issue",
        "workflow error"
    ]):
        return "Workflow Exception"

    return existing if existing else "Other"