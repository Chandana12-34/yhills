# ============================================================
# STEP 1 - GET ACCESS TOKEN
# ============================================================

def get_access_token():

    headers = {
        "Content-Type": "application/json",
        "Content-Length": "0"
    }

    response = requests.post(
        TOKEN_URL,
        auth=HTTPBasicAuth(CLIENT_ID, CLIENT_SECRET),
        cert=(CERT_FILE, KEY_FILE),
        headers=headers,
        timeout=TIMEOUT,
        verify=False
    )

    print("\nToken API Status:", response.status_code)

    if response.status_code != 200:
        print("Token API FAILED")
        print(response.text)
        response.raise_for_status()

    token_data = response.json()

    access_token = token_data.get("access_token")

    if not access_token:
        raise RuntimeError("Access token not found")

    print("Access token received successfully")

    return access_token


# ============================================================
# STEP 2 - MONITOR ALL ENDPOINTS
# ============================================================

def monitor_endpoints(access_token):

    results = []

    print("\n" + "=" * 80)
    print("STARTING ENDPOINT HEALTH CHECK")
    print("=" * 80)

    for endpoint in ENDPOINTS:

        headers = {
            "Authorization": f"Bearer {access_token}",
            "Accept": f"*/*;version={endpoint['version']}"
        }

        try:

            response = requests.get(
                endpoint["url"],
                headers=headers,
                cert=(CERT_FILE, KEY_FILE),
                timeout=TIMEOUT,
                verify=False
            )

            status = response.status_code

            if status == 200:
                health = "UP"
            else:
                health = "DOWN"

            results.append({
                "name": endpoint["name"],
                "version": endpoint["version"],
                "status": status,
                "health": health
            })

            print("\n----------------------------------------")
            print("Endpoint :", endpoint["name"])
            print("Version  :", endpoint["version"])
            print("Status   :", status)
            print("Health   :", health)
            print("Response :", response.text[:500])

        except requests.exceptions.RequestException as e:

            results.append({
                "name": endpoint["name"],
                "version": endpoint["version"],
                "status": "ERROR",
                "health": "DOWN"
            })

            print("\n----------------------------------------")
            print("Endpoint :", endpoint["name"])
            print("Version  :", endpoint["version"])
            print("Status   : ERROR")
            print("Health   : DOWN")
            print("Error    :", e)

    return results


# ============================================================
# MAIN
# ============================================================

def main():

    try:

        # Get token only ONCE
        access_token = get_access_token()

        # Use same token for every endpoint
        results = monitor_endpoints(access_token)

        print("\n")
        print("=" * 80)
        print("FINAL HEALTH CHECK SUMMARY")
        print("=" * 80)

        for result in results:

            print(
                f"{result['version'].upper():6} | "
                f"{result['name']:<35} | "
                f"{result['status']} | "
                f"{result['health']}"
            )

        print("=" * 80)

    except Exception as e:

        print("\nHealth check failed:")
        print(e)


if __name__ == "__main__":
    main()