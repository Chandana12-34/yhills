# ============================================================
# CLEAN TEXT
# ============================================================

def clean_text(value):

    if value is None:
        return ""

    try:

        if pd.isna(value):
            return ""

    except Exception:

        pass

    value = str(value)

    # Remove null characters
    value = value.replace(
        "\x00",
        ""
    )

    # Normalize line endings
    value = value.replace(
        "\r\n",
        "\n"
    )

    value = value.replace(
        "\r",
        "\n"
    )

    # Remove invalid control characters
    value = "".join(
        ch
        for ch in value
        if ch in ("\n", "\t")
        or ord(ch) >= 32
    )

    # Normalize spaces
    value = re.sub(
        r"[ \t]+",
        " ",
        value
    )

    # Normalize excessive blank lines
    value = re.sub(
        r"\n{3,}",
        "\n\n",
        value
    )

    return value.strip()


# ============================================================
# CLEAN JSON RESPONSE
# ============================================================

def clean_json_response(text):

    if not text:

        return ""

    text = str(text).strip()

    # Remove ```json
    text = re.sub(
        r"^```json\s*",
        "",
        text,
        flags=re.IGNORECASE
    )

    # Remove ```
    text = re.sub(
        r"^```\s*",
        "",
        text
    )

    text = re.sub(
        r"\s*```$",
        "",
        text
    )

    return text.strip()


# ============================================================
# EXTRACT JSON
# ============================================================

def extract_json(text):

    text = clean_json_response(
        text
    )

    # --------------------------------------------------------
    # First attempt: direct JSON
    # --------------------------------------------------------

    try:

        return json.loads(
            text,
            strict=False
        )

    except json.JSONDecodeError:

        pass

    # --------------------------------------------------------
    # Second attempt: extract JSON object
    # --------------------------------------------------------

    start = text.find(
        "{"
    )

    end = text.rfind(
        "}"
    )

    if (
        start == -1
        or end == -1
        or end <= start
    ):

        raise ValueError(
            "No JSON object found in LLM response."
        )

    json_text = text[
        start:end + 1
    ]

    try:

        return json.loads(
            json_text,
            strict=False
        )

    except json.JSONDecodeError as e:

        print()
        print(
            "========== JSON PARSE ERROR =========="
        )

        print(
            str(e)
        )

        print(
            "RAW LLM RESPONSE:"
        )

        print(
            text[:10000]
        )

        print(
            "======================================"
        )

        raise


