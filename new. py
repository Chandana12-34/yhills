def fetch_tpapi_health():

    try:

        # Get OAuth token
        access_token = get_access_token()

        # Monitor all BETA + GAMMA endpoints
        results = monitor_endpoints(access_token)

        components = []

        for result in results:

            components.append({
                "name": result["name"],
                "version": result["version"].upper(),
                "status_code": result["status"],
                "status": result["health"]
            })

        # Overall TPAPI status
        if components and all(
            item["status"] == "UP"
            for item in components
        ):
            overall_status = "UP"
            error = None

        else:
            overall_status = "DOWN"
            error = "One or more TPAPI endpoints are DOWN"

        return {
            "endpoint_name": "TPAPI",
            "url": BASE_URL,
            "status": overall_status,
            "details": {},
            "components": components,
            "timestamp": datetime.now().isoformat(),
            "error": error,
            "response_time": None
        }

    except Exception as e:

        return {
            "endpoint_name": "TPAPI",
            "url": BASE_URL,
            "status": "DOWN",
            "details": {},
            "components": [],
            "timestamp": datetime.now().isoformat(),
            "error": str(e),
            "response_time": None
        }