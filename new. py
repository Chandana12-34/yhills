from langflow.custom import Component
from langflow.io import MessageTextInput, Output
from langflow.schema import Data


class PAMMockTool(Component):

    display_name = "PAM Mock Tool"
    description = "Mock PAM service for PAM golden scenarios."
    icon = "shield"
    name = "PAMMockTool"

    inputs = [
        MessageTextInput(
            name="request",
            display_name="PAM Request",
            info="Request received from the PAM agent.",
            tool_mode=True,
        ),
    ]

    outputs = [
        Output(
            display_name="PAM Result",
            name="pam_result",
            method="run_pam",
        ),
    ]

    def run_pam(self) -> Data:

        request = (self.request or "").lower().strip()

        # ==================================================
        # MOCK PAM DATABASE
        # ==================================================

        accounts = {
            "acc-1001": {
                "account_id": "ACC-1001",
                "owner": "Rahul",
                "environment": "PROD",
                "status": "ACTIVE",
                "permissions": [
                    "READ",
                    "REPORT_VIEW"
                ],
                "recertification": "CURRENT",
                "owner_tagged": True
            },

            "acc-1002": {
                "account_id": "ACC-1002",
                "owner": None,
                "environment": "UAT",
                "status": "ACTIVE",
                "permissions": [
                    "READ",
                    "WRITE"
                ],
                "recertification": "PENDING",
                "owner_tagged": False
            }
        }

        # ==================================================
        # SCENARIO 4
        # SERVICE UNAVAILABLE
        # ==================================================

        if (
            "service down" in request
            or "vault unavailable" in request
            or "pam unavailable" in request
            or "pam service is down" in request
        ):
            return Data(
                value={
                    "status": "SERVICE_UNAVAILABLE",
                    "message": "PAM Vault service is currently unavailable."
                }
            )

        # ==================================================
        # SCENARIO 5
        # PRIVILEGED CREDENTIAL REQUEST
        # ==================================================

        if (
            "credential" in request
            or "password" in request
            or "secret" in request
        ):

            account_id = None

            for acc_id in accounts:
                if acc_id in request:
                    account_id = accounts[acc_id]["account_id"]
                    break

            return Data(
                value={
                    "status": "APPROVAL_REQUIRED",
                    "account_id": account_id,
                    "message": (
                        "Privileged credential retrieval requires "
                        "explicit entitlement and approval."
                    ),
                    "credential": None
                }
            )

        # ==================================================
        # SCENARIO 3
        # RECERTIFICATION / MISSING OWNER
        # ==================================================

        if "recert" in request or "recertification" in request:

            for account_id, account in accounts.items():

                if account_id in request:

                    if not account["owner_tagged"]:

                        return Data(
                            value={
                                "status": "MISSING_OWNER",
                                "operation": "RECERTIFICATION",
                                "account_id": account["account_id"],
                                "recertification": account["recertification"],
                                "owner": None,
                                "message": (
                                    "No owner is assigned to this "
                                    "recertification item. "
                                    "Manual ownership resolution is required."
                                )
                            }
                        )

                    return Data(
                        value={
                            "status": "SUCCESS",
                            "operation": "RECERTIFICATION_STATUS",
                            "account_id": account["account_id"],
                            "recertification": account["recertification"],
                            "owner": account["owner"]
                        }
                    )

            return Data(
                value={
                    "status": "NOT_FOUND",
                    "message": "No matching account was found."
                }
            )

        # ==================================================
        # PERMISSION REVIEW
        # ==================================================

        if "permission" in request or "permissions" in request:

            for account_id, account in accounts.items():

                if account_id in request:

                    return Data(
                        value={
                            "status": "SUCCESS",
                            "operation": "PERMISSION_REVIEW",
                            "account_id": account["account_id"],
                            "owner": account["owner"],
                            "environment": account["environment"],
                            "permissions": account["permissions"],
                            "account_status": account["status"]
                        }
                    )

            return Data(
                value={
                    "status": "NOT_FOUND",
                    "message": "No matching PAM account was found."
                }
            )

        # ==================================================
        # ACCOUNT SEARCH
        # ==================================================

        for account_id, account in accounts.items():

            if account_id in request:

                return Data(
                    value={
                        "status": "SUCCESS",
                        "operation": "ACCOUNT_SEARCH",
                        "account_id": account["account_id"],
                        "owner": account["owner"],
                        "environment": account["environment"],
                        "account_status": account["status"]
                    }
                )

        # ==================================================
        # HAPPY PATH - ACCOUNT LIST
        # ==================================================

        if (
            "account list" in request
            or "accounts" in request
            or "review accounts" in request
            or "review the accounts" in request
        ):

            return Data(
                value={
                    "status": "SUCCESS",
                    "operation": "ACCOUNT_LIST",
                    "accounts": [
                        {
                            "account_id": "ACC-1001",
                            "owner": "Rahul",
                            "environment": "PROD",
                            "status": "ACTIVE"
                        },
                        {
                            "account_id": "ACC-1002",
                            "owner": "UNASSIGNED",
                            "environment": "UAT",
                            "status": "ACTIVE"
                        }
                    ]
                }
            )

        # ==================================================
        # UNKNOWN REQUEST
        # ==================================================

        return Data(
            value={
                "status": "NOT_FOUND",
                "message": "No matching PAM request or account was found."
            }
        )