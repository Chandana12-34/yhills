from playwright.sync_api import sync_playwright
import pandas as pd


URL = "https://h2h.cib.echonet/monitor.aspx"


def scrape_h2h():

    with sync_playwright() as p:

        # Open Microsoft Edge
        browser = p.chromium.launch(
            channel="msedge",
            headless=False
        )

        page = browser.new_page()

        print("Opening H2H monitor page...")

        # Don't wait for DOMContentLoaded because this
        # internal page can take a long time to finish loading.
        page.goto(
            URL,
            wait_until="commit",
            timeout=120000
        )

        print("Page opened successfully.")

        # Allow table to render
        page.wait_for_timeout(10000)

        tables = page.locator("table")

        print("Number of tables:", tables.count())

        result = []

        # -----------------------------------------
        # Find the table containing Title + Status
        # -----------------------------------------

        for table_index in range(tables.count()):

            table = tables.nth(table_index)

            rows = table.locator("tr")

            for row_index in range(rows.count()):

                row = rows.nth(row_index)

                # Direct cells belonging to this row
                cells = row.locator(
                    "xpath=./th | ./td"
                )

                values = []

                for cell_index in range(cells.count()):

                    text = cells.nth(cell_index).inner_text()

                    values.append(
                        text.strip()
                    )

                if not values:
                    continue

                # Convert to lowercase for comparison
                headers = [
                    value.lower()
                    for value in values
                ]

                # -----------------------------------------
                # Found the header:
                # Title | Description | Log | Exception | Status
                # -----------------------------------------

                if (
                    "title" in headers
                    and "status" in headers
                ):

                    title_index = headers.index("title")
                    status_index = headers.index("status")

                    print(
                        f"Found monitor table: {table_index + 1}"
                    )

                    print(
                        "Title column:",
                        title_index
                    )

                    print(
                        "Status column:",
                        status_index
                    )

                    # -----------------------------------------
                    # Read rows below header
                    # -----------------------------------------

                    for data_row_index in range(
                        row_index + 1,
                        rows.count()
                    ):

                        data_row = rows.nth(
                            data_row_index
                        )

                        data_cells = data_row.locator(
                            "xpath=./th | ./td"
                        )

                        data = []

                        for cell_index in range(
                            data_cells.count()
                        ):

                            text = (
                                data_cells
                                .nth(cell_index)
                                .inner_text()
                                .strip()
                            )

                            data.append(text)

                        # Make sure required columns exist
                        if len(data) <= status_index:
                            continue

                        title = data[title_index]
                        status = data[status_index]

                        # Ignore empty rows
                        if not title:
                            continue

                        result.append({
                            "Title": title,
                            "Status": status
                        })

                    # We found the correct table
                    break

            # Stop searching tables after finding data
            if result:
                break

        browser.close()

        return pd.DataFrame(result)


# =====================================================
# TEST THE SCRAPER
# =====================================================

if __name__ == "__main__":

    df = scrape_h2h()

    print("\n")
    print("=" * 70)
    print("H2H MONITOR DATA")
    print("=" * 70)

    if df.empty:

        print("No data found.")

    else:

        print(
            df.to_string(index=False)
        )

        print("\nTotal records:", len(df))

        # Save result for testing
        df.to_csv(
            "h2h_monitor.csv",
            index=False
        )

        print(
            "\nSaved to h2h_monitor.csv"
        )