import os
import requests
from requests.auth import HTTPBasicAuth


# ============================================================
# CONFIGURATION
# ============================================================

TOKEN_URL = (
    "https://api-staging-mtls.staging.echonet"
    "/oauth2/v1/token?grant_type=client_credentials"
)

HEALTH_URL = (
    "https://api-staging-mtls.staging.echonet"
    "/ce-third-parties/v2/entities?crdsCode=CLAUPAR"
)

# Store these as environment variables instead of hardcoding
CLIENT_ID = os.getenv("CLIENT_ID")
CLIENT_SECRET = os.getenv("CLIENT_SECRET")

CERT_FILE = "client.crt"
KEY_FILE = "client.key"

TIMEOUT = 30


# ============================================================
# STEP 1: GET ACCESS TOKEN
# ============================================================

def get_access_token():

    headers = {
        "Content-Type": "application/json",
        "Content-Length": "0"
    }

    response = requests.post(
        TOKEN_URL,
        auth=HTTPBasicAuth(CLIENT_ID, CLIENT_SECRET),
        cert=(CERT_FILE, KEY_FILE),
        headers=headers,
        timeout=TIMEOUT
    )

    print("Token API Status:", response.status_code)

    if response.status_code != 200:
        print("Token API failed")
        print("Response:", response.text)
        response.raise_for_status()

    token_data = response.json()

    access_token = token_data.get("access_token")

    if not access_token:
        raise RuntimeError(
            "Access token was not found in token API response"
        )

    return access_token


# ============================================================
# STEP 2: CALL HEALTH CHECK API
# ============================================================

def health_check(access_token):

    headers = {
        "Authorization": f"Bearer {access_token}",
        "Accept": "*/*;version=gamma"
    }

    response = requests.get(
        HEALTH_URL,
        headers=headers,
        cert=(CERT_FILE, KEY_FILE),
        timeout=TIMEOUT
    )

    print("Health Check Status:", response.status_code)

    if response.status_code == 200:
        print("Health Check SUCCESS - 200 OK")
        return True

    print("Health Check FAILED")
    print("Response:", response.text)

    return False


# ============================================================
# MAIN
# ============================================================

def main():

    try:
        # Step 1
        access_token = get_access_token()

        print("Access token received successfully")

        # Step 2
        success = health_check(access_token)

        if success:
            print("FINAL RESULT: 200 OK")
        else:
            print("FINAL RESULT: Health check failed")

    except requests.exceptions.SSLError as e:
        print("SSL/mTLS certificate error:")
        print(e)

    except requests.exceptions.Timeout:
        print("Request timed out")

    except requests.exceptions.RequestException as e:
        print("Request failed:")
        print(e)

    except Exception as e:
        print("Unexpected error:")
        print(e)


if __name__ == "__main__":
    main()