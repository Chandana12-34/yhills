from selenium import webdriver
from selenium.webdriver.edge.options import Options
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
import pandas as pd
import time


URL = "https://h2h.cib.echonet/monitor.aspx"


def scrape_h2h():

    # -----------------------------
    # Configure Microsoft Edge
    # -----------------------------
    options = Options()

    # Keep browser visible while testing
    # DO NOT use headless mode initially

    options.add_argument("--ignore-certificate-errors")

    driver = webdriver.Edge(options=options)

    try:

        print("Opening H2H monitor page...")

        driver.get(URL)

        # Wait until page is loaded
        WebDriverWait(driver, 30).until(
            lambda d: d.execute_script(
                "return document.readyState"
            ) == "complete"
        )

        print("Page loaded.")
        print("Page title:", driver.title)

        # Give internal page some additional time
        time.sleep(5)

        # -----------------------------------------
        # Find the table containing Title + Status
        # -----------------------------------------

        tables = driver.find_elements(By.TAG_NAME, "table")

        print("Tables found:", len(tables))

        results = []

        for table_index, table in enumerate(tables):

            rows = table.find_elements(By.TAG_NAME, "tr")

            if not rows:
                continue

            print(
                f"Checking table {table_index + 1}, "
                f"rows: {len(rows)}"
            )

            # -----------------------------------------
            # Find header row
            # -----------------------------------------

            title_index = None
            status_index = None

            for row in rows:

                cells = row.find_elements(
                    By.XPATH,
                    "./th | ./td"
                )

                values = [
                    cell.text.strip()
                    for cell in cells
                ]

                normalized = [
                    value.lower()
                    for value in values
                ]

                if "title" in normalized and "status" in normalized:

                    title_index = normalized.index("title")
                    status_index = normalized.index("status")

                    print(
                        "Found monitor table!"
                    )

                    print(
                        "Title column:",
                        title_index
                    )

                    print(
                        "Status column:",
                        status_index
                    )

                    break

            # -----------------------------------------
            # If correct table found
            # -----------------------------------------

            if title_index is not None:

                header_found = False

                for row in rows:

                    cells = row.find_elements(
                        By.XPATH,
                        "./th | ./td"
                    )

                    values = [
                        cell.text.strip()
                        for cell in cells
                    ]

                    if not values:
                        continue

                    normalized = [
                        value.lower()
                        for value in values
                    ]

                    # Skip header row
                    if (
                        "title" in normalized
                        and "status" in normalized
                    ):
                        header_found = True
                        continue

                    if not header_found:
                        continue

                    # Make sure both columns exist
                    if (
                        title_index >= len(values)
                        or status_index >= len(values)
                    ):
                        continue

                    title = values[title_index]
                    status = values[status_index]

                    # Ignore completely empty rows
                    if not title:
                        continue

                    results.append({
                        "Title": title,
                        "Status": status
                    })

                break

        # -----------------------------------------
        # Convert to DataFrame
        # -----------------------------------------

        df = pd.DataFrame(results)

        return df

    finally:

        driver.quit()


# ==========================================
# TEST
# ==========================================

if __name__ == "__main__":

    try:

        df = scrape_h2h()

        print("\n==============================")
        print("H2H MONITOR RESULTS")
        print("==============================\n")

        if df.empty:

            print("No data found.")

        else:

            print(df.to_string(index=False))

            print(
                f"\nTotal records: {len(df)}"
            )

    except Exception as e:

        print("\nERROR:")
        print(type(e).__name__)
        print(str(e))