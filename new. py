{action_taken}

========================================

Now produce the higher-level analysis.

Return ONLY valid JSON in exactly this format:

{{
    "E - High Level Categorisation": "",
    "F - High Level Action Taken": ""
}}
"""


# ============================================================
# CALL LLM
# ============================================================

def call_llm(
    system_prompt,
    user_prompt
):

    headers = {

        "Content-Type":
            "application/json",

        "Authorization":
            f"Bearer {API_KEY}"
    }

    payload = {

        "model":
            MODEL_NAME,

        "temperature":
            0,

        "messages": [

            {
                "role":
                    "system",

                "content":
                    system_prompt
            },

            {
                "role":
                    "user",

                "content":
                    user_prompt
            }
        ]
    }

    last_error = None

    # --------------------------------------------------------
    # Retry mechanism
    # --------------------------------------------------------

    for attempt in range(
        1,
        MAX_RETRIES + 1
    ):

        try:

            response = requests.post(

                API_URL,

                headers=headers,

                json=payload,

                timeout=REQUEST_TIMEOUT,

                verify=False
            )

            # ------------------------------------------------
            # Show API errors clearly
            # ------------------------------------------------

            if not response.ok:

                print()

                print(
                    "========== LLM API ERROR =========="
                )

                print(
                    "HTTP STATUS:",
                    response.status_code
                )

                print(
                    "RESPONSE:",
                    response.text[:5000]
                )

                print(
                    "==================================="
                )

                print()

            response.raise_for_status()

            response_json = response.json()

            # ------------------------------------------------
            # Extract LLM content
            # ------------------------------------------------

            try:

                content = (

                    response_json
                    ["choices"]
                    [0]
                    ["message"]
                    ["content"]

                )

            except (
                KeyError,
                IndexError,
                TypeError
            ):

                raise ValueError(

                    "Unexpected LLM response:\n"

                    + json.dumps(
                        response_json,
                        indent=2
                    )
                )

            return content

        except Exception as e:

            last_error = e

            if attempt < MAX_RETRIES:

                wait_time = (
                    attempt * 3
                )

                print(
                    f"LLM request failed. "
                    f"Retry {attempt}/"
                    f"{MAX_RETRIES - 1} "
                    f"in {wait_time}s..."
                )

                time.sleep(
                    wait_time
                )

            else:

                print(
                    "LLM request failed after "
                    f"{MAX_RETRIES} attempts."
                )

    raise last_error


# ============================================================
# ANALYZE ONE RITM - ITERATION 2
# ============================================================

def analyze_iteration_2(row):

    ritm = clean_text(
        row["A - RITM"]
    )

    print(
        f"Iteration 2 -> Processing {ritm}"
    )

    try:

        # ----------------------------------------------------
        # Build prompt
        # ----------------------------------------------------

        prompt = build_iteration_2_prompt(
            row
        )

        # ----------------------------------------------------
        # Call LLM
        # ----------------------------------------------------

        response = call_llm(

            SYSTEM_PROMPT_ITERATION_2,

            prompt
        )

        # ----------------------------------------------------
        # Extract JSON
        # ----------------------------------------------------

        result = extract_json(
            response
        )

        # ----------------------------------------------------
        # Get Iteration 2 fields
        # ----------------------------------------------------

        high_level_category = clean_text(

            result.get(
                "E - High Level Categorisation",
                ""
            )
        )

        high_level_action = clean_text(

            result.get(
                "F - High Level Action Taken",
                ""
            )
        )

        # ----------------------------------------------------
        # Return complete final row
        # ----------------------------------------------------

        return {

            "A - RITM":
                ritm,

            "B - Issue Summary":
                clean_text(
                    row[
                        "B - Issue Summary"
                    ]
                ),

            "C - Category 1":
                clean_text(
                    row[
                        "C - Category 1"
                    ]
                ),

            "D - Action Taken":
                clean_text(
                    row[
                        "D - Action Taken"
                    ]
                ),

            "E - High Level Categorisation":
                high_level_category,

            "F - High Level Action Taken":
                high_level_action
        }

    except Exception as e:

        print()

        print(
            f"ERROR Iteration 2 -> {ritm}"
        )

        print(
            str(e)
        )

        print()

        # ----------------------------------------------------
        # IMPORTANT:
        # Preserve Iteration 1 values even if Iteration 2
        # fails.
        # ----------------------------------------------------

        return {

            "A - RITM":
                ritm,

            "B - Issue Summary":
                clean_text(
                    row[
                        "B - Issue Summary"
                    ]
                ),

            "C - Category 1":
                clean_text(
                    row[
                        "C - Category 1"
                    ]
                ),

            "D - Action Taken":
                clean_text(
                    row[
                        "D - Action Taken"
                    ]
                ),

            "E - High Level Categorisation":
                "ERROR",

            "F - High Level Action Taken":
                "ERROR"
        }


# ============================================================
# SAVE FINAL EXCEL
# ============================================================

def save_final_excel(
    df,
    output_file
):

    with pd.ExcelWriter(

        output_file,

        engine="xlsxwriter"

    ) as writer:

        df.to_excel(

            writer,

            sheet_name="Final Analysis",

            index=False
        )

        workbook = writer.book

        worksheet = writer.sheets[
            "Final Analysis"
        ]

        # ----------------------------------------------------
        # Header format
        # ----------------------------------------------------

        header_format = workbook.add_format({

            "bold": True,

            "bg_color": "#CFE2F3",

            "border": 1,

            "text_wrap": True,

            "valign": "top"
        })

        # ----------------------------------------------------
        # Cell format
        # ----------------------------------------------------

        cell_format = workbook.add_format({

            "text_wrap": True,

            "valign": "top",

            "border": 1
        })

        # ----------------------------------------------------
        # Headers
        # ----------------------------------------------------

        for col_num, column in enumerate(
            df.columns
        ):

            worksheet.write(

                0,

                col_num,

                column,

                header_format
            )

        # ----------------------------------------------------
        # Cells
        # ----------------------------------------------------

        for row_num in range(

            1,

            len(df) + 1

        ):

            for col_num in range(

                len(df.columns)

            ):

                value = df.iloc[
                    row_num - 1,
                    col_num
                ]

                if pd.isna(value):

                    value = ""

                worksheet.write(

                    row_num,

                    col_num,

                    value,

                    cell_format
                )

        # ----------------------------------------------------
        # Column widths
        # ----------------------------------------------------

        widths = {

            "A:A": 20,

            "B:B": 50,

            "C:C": 35,

            "D:D": 60,

            "E:E": 40,

            "F:F": 60
        }

        for column_range, width in (
            widths.items()
        ):

            worksheet.set_column(

                column_range,

                width,

                cell_format
            )

        # ----------------------------------------------------
        # Freeze header
        # ----------------------------------------------------

        worksheet.freeze_panes(
            1,
            0
        )

        # ----------------------------------------------------
        # Filter
        # ----------------------------------------------------

        worksheet.autofilter(

            0,

            0,

            len(df),

            len(df.columns) - 1
        )


# ============================================================
# LOAD PREVIOUS FINAL RESULTS
# ============================================================

def load_existing_results():

    if not RESUME_ENABLED:

        return {}

    if not Path(
        FINAL_OUTPUT_FILE
    ).exists():

        return {}

    try:

        existing_df = pd.read_excel(

            FINAL_OUTPUT_FILE,

            sheet_name="Final Analysis",

            engine="openpyxl"
        )

    except Exception as e:

        print(
            "Could not read existing final output."
        )

        print(
            str(e)
        )

        return {}

    # --------------------------------------------------------
    # Make sure required columns exist
    # --------------------------------------------------------

    if not set(
        FINAL_COLUMNS
    ).issubset(
        existing_df.columns
    ):

        return {}

    results = {}

    # --------------------------------------------------------
    # Read completed records
    # --------------------------------------------------------

    for _, row in existing_df.iterrows():

        ritm = clean_text(
            row[
                "A - RITM"
            ]
        )

        category = clean_text(
            row[
                "E - High Level Categorisation"
            ]
        )

        action = clean_text(
            row[
                "F - High Level Action Taken"
            ]
        )

        # Only consider successfully completed rows
        # as completed.

        if (

            ritm

            and category

            and action

            and category != "ERROR"

            and action != "ERROR"

        ):

            results[ritm] = {

                "A - RITM":
                    ritm,

                "B - Issue Summary":
                    clean_text(
                        row[
                            "B - Issue Summary"
                        ]
                    ),

                "C - Category 1":
                    clean_text(
                        row[
                            "C - Category 1"
                        ]
                    ),

                "D - Action Taken":
                    clean_text(
                        row[
                            "D - Action Taken"
                        ]
                    ),

                "E - High Level Categorisation":
                    category,

                "F - High Level Action Taken":
                    action
            }

    print(
        f"Resume: {len(results)} "
        f"completed RITMs found."
    )

    return results


# ============================================================
# MAIN
# ============================================================

def main():

    print()

    print(
        "=" * 70
    )

    print(
        "RITM ITERATION 2 - FINAL OUTPUT"
    )

    print(
        "=" * 70
    )

    # ========================================================
    # CHECK INPUT FILE
    # ========================================================

    if not Path(
        ITERATION_1_FILE
    ).exists():

        raise FileNotFoundError(

            f"\nInput file not found:\n"
            f"{Path(ITERATION_1_FILE).resolve()}\n\n"

            "Make sure RITM_Iteration_1.xlsx "
            "is in the same folder as this script."
        )

    # ========================================================
    # CHECK API CONFIGURATION
    # ========================================================

    if (

        not API_URL

        or API_URL ==
        "YOUR_LLM_API_URL"

    ):

        raise ValueError(
            "LLM_API_URL is not configured."
        )

    if (

        not API_KEY

        or API_KEY ==
        "YOUR_LLM_API_KEY"

    ):

        raise ValueError(
            "LLM_API_KEY is not configured."
        )

    if (

        not MODEL_NAME

        or MODEL_NAME ==
        "YOUR_MODEL_NAME"

    ):

        raise ValueError(
            "LLM model name is not configured."
        )

    # ========================================================
    # READ ITERATION 1 FILE
    # ========================================================

    print()

    print(
        f"Reading: {ITERATION_1_FILE}"
    )

    iteration_1_df = pd.read_excel(

        ITERATION_1_FILE,

        sheet_name=0,

        engine="openpyxl"
    )

    print(

        "Iteration 1 rows found: "
        f"{len(iteration_1_df)}"

    )

    # ========================================================
    # VALIDATE COLUMNS
    # ========================================================

    missing = [

        column

        for column in ITERATION_1_COLUMNS

        if column not in iteration_1_df.columns

    ]

    if missing:

        raise ValueError(

            "The Iteration 1 file is missing "
            "the following columns:\n"

            + "\n".join(

                f"- {column}"

                for column in missing

            )

            + "\n\nAvailable columns:\n"

            + "\n".join(

                f"- {column}"

                for column in iteration_1_df.columns

            )
        )

    # ========================================================
    # LOAD EXISTING RESULTS
    # ========================================================

    completed = load_existing_results()

    results = []

    total = len(
        iteration_1_df
    )

    # ========================================================
    # PROCESS ITERATION 2
    # ========================================================

    for index, row in (
        iteration_1_df.iterrows()
    ):

        ritm = clean_text(
            row[
                "A - RITM"
            ]
        )

        # ----------------------------------------------------
        # Resume support
        # ----------------------------------------------------

        if (

            RESUME_ENABLED

            and ritm in completed

        ):

            result = completed[
                ritm
            ]

            results.append(
                result
            )

            print(

                f"[{index + 1}/{total}] "
                f"Skipping completed {ritm}"

            )

            continue

        # ----------------------------------------------------
        # Process ticket
        # ----------------------------------------------------

        print()

        print(
            f"[{index + 1}/{total}]"
        )

        result = analyze_iteration_2(
            row
        )

        results.append(
            result
        )

        # ----------------------------------------------------
        # SAVE AFTER EVERY TICKET
        # ----------------------------------------------------
        #
        # This is important for 2653 records.
        #
        # If the API fails or your laptop stops at ticket 800,
        # the previous results are already saved.
        #
        # ----------------------------------------------------

        current_df = pd.DataFrame(

            results,

            columns=FINAL_COLUMNS
        )

        save_final_excel(

            current_df,

            FINAL_OUTPUT_FILE
        )

        # ----------------------------------------------------
        # Wait before next API call
        # ----------------------------------------------------

        time.sleep(
            SLEEP_BETWEEN_REQUESTS
        )

    # ========================================================
    # FINAL SAVE
    # ========================================================

    final_df = pd.DataFrame(

        results,

        columns=FINAL_COLUMNS
    )

    save_final_excel(

        final_df,

        FINAL_OUTPUT_FILE
    )

    # ========================================================
    # SUMMARY
    # ========================================================

    error_count = (

        (

            final_df[
                "E - High Level Categorisation"
            ]

            == "ERROR"

        )

        |

        (

            final_df[
                "F - High Level Action Taken"
            ]

            == "ERROR"

        )

    ).sum()

    print()

    print(
        "=" * 70
    )

    print(
        "ITERATION 2 COMPLETED"
    )

    print(
        "=" * 70
    )

    print(

        "Iteration 1 records read: "
        f"{len(iteration_1_df)}"

    )

    print(

        "Final output records: "
        f"{len(final_df)}"

    )

    print(

        "Iteration 2 errors: "
        f"{error_count}"

    )

    print()

    print(
        "Final file:"
    )

    print(
        Path(
            FINAL_OUTPUT_FILE
        ).resolve()
    )

    print()

    print(
        "=" * 70
    )


# ============================================================
# ENTRY POINT
# ============================================================

if __name__ == "__main__":

    main()