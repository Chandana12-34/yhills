import pandas as pd
from playwright.sync_api import sync_playwright


URL = "https://h2h.cib.echonet/monitor.aspx"


def scrape_h2h():

    result = []

    with sync_playwright() as p:

        browser = p.chromium.launch(
            channel="msedge",
            headless=False
        )

        page = browser.new_page()

        try:

            print("Opening H2H monitor page...")

            page.goto(
                URL,
                wait_until="commit",
                timeout=120000
            )

            print("Page opened successfully.")

            # Give the page time to render
            page.wait_for_timeout(10000)

            tables = page.locator("table")

            print(
                "Number of tables:",
                tables.count()
            )

            # Find the table containing Title and Status
            for table_index in range(tables.count()):

                table = tables.nth(table_index)

                rows = table.locator("tr")

                for row_index in range(rows.count()):

                    row = rows.nth(row_index)

                    cells = row.locator(
                        "xpath=./th | ./td"
                    )

                    headers = []

                    for i in range(cells.count()):

                        headers.append(
                            cells.nth(i)
                            .inner_text()
                            .strip()
                            .lower()
                        )

                    if (
                        "title" in headers
                        and "status" in headers
                    ):

                        title_index = headers.index(
                            "title"
                        )

                        status_index = headers.index(
                            "status"
                        )

                        print(
                            "Found H2H monitor table."
                        )

                        # Read rows below header
                        for r in range(
                            row_index + 1,
                            rows.count()
                        ):

                            data_row = rows.nth(r)

                            data_cells = data_row.locator(
                                "xpath=./th | ./td"
                            )

                            values = []

                            for c in range(
                                data_cells.count()
                            ):

                                values.append(
                                    data_cells
                                    .nth(c)
                                    .inner_text()
                                    .strip()
                                )

                            if len(values) <= status_index:
                                continue

                            title = values[
                                title_index
                            ]

                            status = values[
                                status_index
                            ]

                            if not title:
                                continue

                            result.append({
                                "Title": title,
                                "Status": status
                            })

                        break

                if result:
                    break

        finally:

            browser.close()

    return pd.DataFrame(result)


if __name__ == "__main__":

    df = scrape_h2h()

    print("\n")
    print("=" * 70)
    print("H2H MONITOR DATA")
    print("=" * 70)

    print(
        df.to_string(index=False)
    )

    print("\nTotal records:", len(df))