from playwright.sync_api import sync_playwright

URL = "https://h2h.cib.echonet/monitor.aspx"


with sync_playwright() as p:

    print("Opening Microsoft Edge...")

    browser = p.chromium.launch(
        channel="msedge",
        headless=False
    )

    page = browser.new_page()

    print("Opening H2H monitor page...")

    try:

        # IMPORTANT:
        # Use "commit" instead of "domcontentloaded"
        page.goto(
            URL,
            wait_until="commit",
            timeout=120000
        )

        print("Navigation started successfully.")

    except Exception as e:

        print("Navigation error:")
        print(type(e).__name__)
        print(str(e))

    # Give the page time to render
    print("Waiting for page...")
    page.wait_for_timeout(15000)

    print("Current URL:")
    print(page.url)

    print("Page title:")
    print(page.title())

    print("Page content length:")
    print(len(page.content()))

    # Save whatever Playwright received
    with open(
        "h2h_page.html",
        "w",
        encoding="utf-8"
    ) as f:

        f.write(page.content())

    print("Saved page to h2h_page.html")

    print("Browser will remain open for 30 seconds.")

    page.wait_for_timeout(30000)

    browser.close()