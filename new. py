def fetch_monitor_results(url):

    driver = None

    try:
        # Create Edge driver
        options = Options()
        options.add_argument("--start-maximized")
        options.page_load_strategy = "eager"

        service = Service(EDGE_DRIVER_PATH)

        driver = webdriver.Edge(
            service=service,
            options=options
        )

        driver.set_page_load_timeout(10)

        # Open monitor page
        try:
            driver.get(url)
        except Exception as e:
            print("Page load timed out, continuing to scrape:", e)

        # Wait for the monitor table
        table = WebDriverWait(
            driver,
            120
        ).until(
            EC.presence_of_element_located(
                (By.ID, "gvTestResults")
            )
        )

        # Get all data rows
        rows = table.find_elements(
            By.XPATH,
            ".//tbody/tr[position() > 1]"
        )

        results = []

        for row in rows:

            cells = row.find_elements(
                By.TAG_NAME,
                "td"
            )

            if len(cells) >= 5:

                title = cells[0].text.strip()
                status = cells[4].text.strip()

                # Convert Selenium Pass/Fail
                # into dashboard UP/DOWN
                if status.lower() == "pass":
                    health_status = "UP"
                else:
                    health_status = "DOWN"

                results.append({
                    "name": title,
                    "status": health_status
                })

        print("SELENIUM RESULTS:", results)

        return results

    except Exception as e:

        print("SELENIUM ERROR:", e)

        return [{
            "name": "Monitor",
            "status": "DOWN",
            "error": str(e)
        }]

    finally:

        if driver:
            driver.quit()