def render_tpapi_details():
    data = st.session_state.health_data.get("TPAPI")

    if not data:
        st.warning("TPAPI health data not available.")
        return

    components = data.get("components", [])

    beta = [x for x in components if x.get("version") == "BETA"]
    gamma = [x for x in components if x.get("version") == "GAMMA"]

    st.markdown("## TPAPI Health Check")

    col1, col2 = st.columns(2)

    with col1:
        st.markdown("### BETA")

        for item in beta:
            icon = "🟢" if item.get("status") == "UP" else "🔴"

            st.markdown(
                f"**{icon} {item.get('name')}** — "
                f"{item.get('status_code')} {item.get('status')}"
            )

    with col2:
        st.markdown("### GAMMA")

        for item in gamma:
            icon = "🟢" if item.get("status") == "UP" else "🔴"

            st.markdown(
                f"**{icon} {item.get('name')}** — "
                f"{item.get('status_code')} {item.get('status')}"
            )