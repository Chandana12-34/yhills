def normalize_subcategory(category, subcategory="", issue_summary=""):
    """
    Normalize sub-categories based on the approved parent category.
    """

    category = str(category).strip()
    subcategory = str(subcategory).strip()
    issue_summary = str(issue_summary).strip().lower()

    # ============================================================
    # TECHNICAL SUPPORT
    # ============================================================
    if category.lower() == "technical support":

        if any(keyword in issue_summary for keyword in [
            "upstream",
            "downstream",
            "crds",
            "data synchronization",
            "data synchronisation",
            "synchronization",
            "synchronisation"
        ]):
            return "Up & Downstream with CRDS"

        if subcategory:
            return subcategory

        return "Other"

    # ============================================================
    # FUNCTIONAL SUPPORT
    # ============================================================
    if category.lower() == "functional support":

        if subcategory:
            return subcategory

        return "Other"

    # ============================================================
    # APPLICATION ISSUE
    # ============================================================
    application_issue_categories = [
        "performance and slowness",
        "decision making (issue faced at decision stage)",
        "data flow internal (internal flow of data between tasks and stages)",
        "front office initiation/validation (business power)",
        "hierarchy (issue at creation or display of hierarchy)",
        "kyc and escalation form",
        "screening issue",
        "user interface (issue with wrong or missing data in ui)",
        "workflow exception",
        "other"
    ]

    if category.lower() in application_issue_categories:
        return ""

    return subcategory